---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { research } from '../data/research';
import { publications } from '../data/publications';
const papersById = new Map(publications.map((paper) => [paper.id, paper]));
---

<Layout title="Research">
  <PageHeading title="Research" compact />
  <p class="research-introduction">
    We study how robots perceive, learn, and act in the real world. Our research spans five
    connected directions, from robust movement and autonomous navigation to manipulation and
    whole-body skills.
  </p>
  <nav class="research-toc" aria-label="Research topics">
    <ul>
      {research.map((area) => (
        <li>
          <a class="topic-entry" href={`#${area.id}`}>
            <h2>{area.title}</h2>
            <p>{area.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="research-list">
    {research.map((area) => (
      <section class="research-topic" id={area.id} aria-labelledby={`${area.id}-heading`}>
        <h2 id={`${area.id}-heading`}>{area.title}</h2>
        <div class="selected-publications">
          {area.publications.map((id) => {
            const paper = papersById.get(id);
            return paper && <PublicationEntry publication={paper} anchorId={`${area.id}-${id}`} />;
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>
