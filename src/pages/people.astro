---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import PersonCard from '../components/PersonCard.astro';
import { faculty, peopleGroups, alumniGroups } from '../data/people';
const hasExamples = [...peopleGroups, ...alumniGroups].some((group) =>
  group.members.some((person) => person.isPlaceholder),
);
---

<Layout title="People">
  <PageHeading title="People" />
  <section class="people-section" aria-labelledby="faculty-heading">
    <h2 id="faculty-heading">Faculty</h2>
    <div class="faculty-list">
      {faculty.map((person) => (
        <PersonCard person={person} variant="faculty" />
      ))}
    </div>
  </section>
  {hasExamples && (
    <p class="sample-members-note">
      The member entries below are fictional examples for layout review.
    </p>
  )}
  {peopleGroups.map(
    (group) =>
      group.members.length > 0 && (
        <section class="people-section" aria-labelledby={`${group.id}-heading`}>
          <h2 id={`${group.id}-heading`}>{group.title}</h2>
          <div class="people-grid">
            {group.members.map((person) => (
              <PersonCard
                person={person}
                yearLabel={group.id === 'postdocs' ? 'Joined' : 'Enrolled'}
              />
            ))}
          </div>
        </section>
      ),
  )}
  <section class="people-section alumni-section" id="alumni" aria-labelledby="alumni-heading">
    <h2 id="alumni-heading">Alumni</h2>
    {alumniGroups.map((group) => (
      <section class="alumni-group" aria-labelledby={group.id}>
        <h3 id={group.id}>{group.title}</h3>
        <ul class="alumni-list">
          {group.members.map((person) => (
            <li data-placeholder={person.isPlaceholder || undefined}>
              <span class="alumni-name">
                {person.profile ? <a href={person.profile}>{person.name}</a> : person.name}
              </span>
              <div class="alumni-details">
                <p>
                  {`was with the lab from ${person.startYear} to ${person.endYear}${
                    person.degree
                      ? ` and received a ${person.degree.title} in ${person.degree.year}.`
                      : '.'
                  }`}
                </p>
                {person.destination && <span class="alumni-destination">{person.destination}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</Layout>
