---
import { site } from '../data/site';
import { withBase } from '../lib/paths';
import LabLogo from './LabLogo.astro';
import SocialIcon from './SocialIcon.astro';
---

<footer class="site-footer container">
  <div class="footer-content">
    <div class="footer-brands" aria-label="University and lab">
      <a class="footer-brand" href="https://www.zju.edu.cn/" aria-label="Zhejiang University">
        <img
          class="footer-university-logo"
          src={withBase('/images/brand/zhejiang-university.svg')}
          alt="Zhejiang University"
          width="175"
          height="175"
        />
      </a>
      <a class="footer-brand" href={withBase('/')} aria-label={`${site.name} home`}>
        <LabLogo class="footer-lab-logo" />
      </a>
    </div>
    <div class="social-links" aria-label="Lab social channels">
      <a class="social-link" href={site.youtube} aria-label="RMI Lab on YouTube" title="YouTube">
        <SocialIcon name="youtube" />
      </a>
      {site.github ? (
        <a class="social-link" href={site.github} aria-label="RMI Lab on GitHub" title="GitHub">
          <SocialIcon name="github" />
        </a>
      ) : (
        <span
          class="social-link social-placeholder"
          role="img"
          aria-label="GitHub link to be added"
          aria-disabled="true"
          title="GitHub link to be added"
        >
          <SocialIcon name="github" />
        </span>
      )}
    </div>
  </div>
</footer>
