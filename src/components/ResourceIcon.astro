---
import type { IconName } from '../data/types';
import SocialIcon from './SocialIcon.astro';
interface Props {
  name: IconName;
}
const { name } = Astro.props;
const paths: Record<Exclude<IconName, 'github'>, string> = {
  paper: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h6',
  video: 'M9 7l8 5-8 5z M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z',
  website: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0 M3 12h18 M12 3c5 5 5 13 0 18-5-5-5-13 0-18',
  email: 'M3 5h18v14H3z M3 5l9 7 9-7',
  scholar: 'M2 9l10-6 10 6-10 6z M6 12v6c4 3 8 3 12 0v-6 M22 9v8',
  cite: 'M10 5H4v7h5c0 4-2 6-5 7 M20 5h-6v7h5c0 4-2 6-5 7',
};
---

<span class="resource-icon" aria-hidden="true">
  {name === 'github' ? (
    <SocialIcon name="github" />
  ) : (
    <svg
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
    >
      <path d={paths[name]} />
    </svg>
  )}
</span>
