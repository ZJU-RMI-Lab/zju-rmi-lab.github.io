---
interface Props {
  title: string;
  description?: string;
  compact?: boolean;
}
const { title, description, compact = false } = Astro.props;
---

<div class:list={['page-heading', { 'page-heading-compact': compact }]}>
  <h1>{title}</h1>
  {description && <p>{description}</p>}
  <slot />
</div>
